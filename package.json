{
  "name": "smart-price-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:extension": "npm run dev -w apps/extension",
    "run:tracker": "npm start -w services/price-tracker",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:cleanup": "tsx scripts/cleanup.ts"
  }
}
