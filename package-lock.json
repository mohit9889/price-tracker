{
  "name": "smart-price-tracker",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "smart-price-tracker",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "services/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@price-tracker/api",
      "version": "1.0.0"
    },
    "apps/extension": {
      "name": "@price-tracker/extension",
      "version": "1.0.0"
    },
    "node_modules/@price-tracker/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@price-tracker/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@price-tracker/price-tracker": {
      "resolved": "services/price-tracker",
      "link": true
    },
    "node_modules/@price-tracker/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@price-tracker/shared-utils": {
      "resolved": "packages/shared-utils",
      "link": true
    },
    "packages/shared-types": {
      "name": "@price-tracker/shared-types",
      "version": "1.0.0"
    },
    "packages/shared-utils": {
      "name": "@price-tracker/shared-utils",
      "version": "1.0.0",
      "dependencies": {
        "@price-tracker/shared-types": "*"
      }
    },
    "services/price-tracker": {
      "name": "@price-tracker/price-tracker",
      "version": "1.0.0"
    }
  }
}
